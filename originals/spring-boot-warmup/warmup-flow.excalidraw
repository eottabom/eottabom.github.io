      "link": null,
      "locked": false,
      "text": "HTTP 로 부르면 실제 요청과 같은 길에서 클래스 로딩, 초기화가 끝난다",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP 로 부르면 실제 요청과 같은 길에서 클래스 로딩, 초기화가 끝난다",
      "autoResize": true,
      "lineHeight": 1.35
    },
