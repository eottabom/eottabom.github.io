  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:rss": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register scripts/generate-rss.ts",
    "generate:sitemap": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register scripts/generate-sitemap.ts",
    "generate:seo": "npm run generate:sitemap && npm run generate:rss",
    "check:knowledge": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register scripts/check-knowledge.ts",
    "classify:knowledge": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register scripts/classify-knowledge.ts",
    "test": "TS_NODE_PROJECT=tsconfig.scripts.json node --require ts-node/register --test \"lib/**/*.test.ts\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@giscus/react": "^3.1.0",
    "cytoscape": "^3.34.4",
