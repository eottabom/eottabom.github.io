    "gray-matter": "^4.0.3",
    "lucide-react": "^0.268.0",
    "mermaid": "11.17.2",
    "next": "^16.4.5",
    "next-mdx-remote": "6.0.0",
    "prism-themes": "^1.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-autolink-headings": "6.1.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "5.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
