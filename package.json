    "@types/node": "26.5.1",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
